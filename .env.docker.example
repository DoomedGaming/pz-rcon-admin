# Optional Docker/Compose overrides for automated deployments. The normal Compose
# flow uses the one-time encrypted setup screen and does not require this file.
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_PASSWORD=replace-with-a-long-unique-password
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters
DASHBOARD_SECURE_COOKIE=false

PZ_RCON_HOST=your-server-ip
PZ_RCON_PORT=your-rcon-port
PZ_RCON_PASSWORD=your-rcon-password
PZ_RCON_POLL_SECONDS=15

PZ_TELEMETRY_TOKEN=

# Optional FTP/FTPS deep telemetry bridge. The exporter is a directly installed
# server utility, not a mod or Workshop item. Leave all four credential values blank
# to disable FTP telemetry.
PZ_TELEMETRY_FTP_HOST=
PZ_TELEMETRY_FTP_PORT=21
PZ_TELEMETRY_FTP_USER=
PZ_TELEMETRY_FTP_PASSWORD=
PZ_TELEMETRY_FTP_SECURE=false
PZ_TELEMETRY_FTP_PATH=Lua/DoomedTelemetry/players.json
PZ_TELEMETRY_FTP_POLL_SECONDS=60

PZ_PLAYER_AUTH_ENABLED=false
PZ_PLAYER_SESSION_SECRET=replace-with-a-different-32-character-random-secret
PZ_PLAYER_DB_FTP_PATH=db/servertest.db
PZ_PLAYER_DB_WORLD=servertest

# Public identity and landing-page copy.
PZ_BRAND_NAME=My Project Zomboid Community
PZ_BRAND_INITIALS=MPZ
PZ_BRAND_TAGLINE=Survive together
PZ_PORTAL_TITLE=Your life. Your record.
PZ_PORTAL_DESCRIPTION=Check the server, jump back in, or open your private character record.
PZ_PLAYER_JOIN_ADDRESS=
PZ_PLAYER_DISCORD_URL=
PZ_PLAYER_RULES_URL=
PZ_PLAYER_MODS_URL=
PZ_PLAYER_RESTART_SCHEDULE=
PZ_PLAYER_ANNOUNCEMENT=

PZ_PROVIDER_NAME=My hosting provider
PZ_PROVIDER_URL=https://provider.example.com/my-server

# Used only with compose.config-files.yaml.
PZ_CONFIG_HOST_PATH=/absolute/host/path/to/servertest.ini
PZ_SANDBOX_HOST_PATH=/absolute/host/path/to/servertest_SandboxVars.lua
