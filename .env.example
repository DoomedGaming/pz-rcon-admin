# Optional environment overrides for automation. Interactive installs should use
# the one-time /setup screen instead; no env file is required.
# Dashboard HTTP server. Keep the default loopback host unless you deliberately
# put the dashboard behind HTTPS and an authentication-aware reverse proxy.
HOST=127.0.0.1
PORT=8787
DASHBOARD_PASSWORD=replace-with-a-long-unique-password
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-characters
# Set true only when the dashboard itself is served over HTTPS.
DASHBOARD_SECURE_COOKIE=false

# Project Zomboid RCON. The password may instead be read from PZ_CONFIG_PATH.
PZ_RCON_HOST=your-server-ip
PZ_RCON_PORT=your-rcon-port
PZ_RCON_PASSWORD=your-rcon-password
PZ_RCON_POLL_SECONDS=15

# Optional local read-only config import. Local files override FTP retrieval.
PZ_CONFIG_PATH=/absolute/path/to/servertest.ini
PZ_SANDBOX_PATH=/absolute/path/to/servertest_SandboxVars.lua

# Optional authenticated HTTP receiver for custom telemetry senders.
PZ_TELEMETRY_TOKEN=replace-with-a-separate-random-token

# Optional FTP/FTPS server-file bridge. It retrieves deep telemetry plus the
# server INI and SandboxVars files on the same polling interval.
PZ_TELEMETRY_FTP_HOST=your-provider-ftp-host
PZ_TELEMETRY_FTP_PORT=your-provider-ftp-port
PZ_TELEMETRY_FTP_USER=your-provider-ftp-user
PZ_TELEMETRY_FTP_PASSWORD=your-provider-ftp-password
PZ_TELEMETRY_FTP_SECURE=false
PZ_TELEMETRY_FTP_PATH=Lua/PZRconAdminTelemetry/players.json
PZ_TELEMETRY_FTP_POLL_SECONDS=60
PZ_CONFIG_FTP_PATH=Server/servertest.ini
PZ_SANDBOX_FTP_PATH=Server/servertest_SandboxVars.lua

# Optional player portal at /. The protected administrator console is at /admin.
# This verifies the per-user Project Zomboid
# account password from db/servertest.db; it is not the shared server password.
# Keep disabled unless the site is private/VPN-only or fully protected by HTTPS.
PZ_PLAYER_AUTH_ENABLED=false
PZ_PLAYER_SESSION_SECRET=replace-with-a-different-32-character-random-secret
PZ_PLAYER_DB_FTP_PATH=db/servertest.db
PZ_PLAYER_DB_WORLD=servertest

# Public identity and landing-page copy. PZ_BRAND_NAME defaults to the server's
# PublicName from servertest.ini, then to "Project Zomboid". Initials are derived
# automatically when omitted. Public links must use http:// or https://.
PZ_BRAND_NAME=My Project Zomboid Community
PZ_BRAND_INITIALS=MPZ
PZ_BRAND_TAGLINE=Survive together
PZ_PORTAL_TITLE=Your life. Your record.
PZ_PORTAL_DESCRIPTION=Check the server, jump back in, or open your private character record.
PZ_PLAYER_JOIN_ADDRESS=example.com:16261
PZ_PLAYER_DISCORD_URL=https://discord.gg/your-group
PZ_PLAYER_RULES_URL=https://example.com/server-rules
PZ_PLAYER_MODS_URL=https://steamcommunity.com/sharedfiles/filedetails/?id=your-collection-id
PZ_PLAYER_RESTART_SCHEDULE=Nightly at 4:00 AM Central
PZ_PLAYER_ANNOUNCEMENT=Check the group chat before the next session.

# Optional hosting-provider deep link. This stores only a label and URL, never
# provider credentials. GPORTAL_SERVER_URL remains supported as a legacy alias.
PZ_PROVIDER_NAME=My hosting provider
PZ_PROVIDER_URL=https://provider.example.com/my-server
